# syntax=docker/dockerfile:1

# Fully static/native container image for standard-tools-go.
# Build stage
FROM golang:1.25-alpine AS builder

# Ensure the CA bundle is present in the builder so we can copy it into scratch.
RUN apk add --no-cache ca-certificates

WORKDIR /src

# Cache dependency downloads.
COPY go.mod go.sum ./
RUN go mod download

# Copy the rest of the source tree.
COPY . .

# Build a fully static, stripped Linux binary.
ENV CGO_ENABLED=0 GOOS=linux
RUN go build -trimpath -ldflags='-s -w' -o /usr/local/bin/server ./cmd/server

# Final stage: empty scratch image with only the static binary and CA certs.
FROM scratch

COPY --from=builder /usr/local/bin/server /usr/local/bin/server
COPY --from=builder /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/ca-certificates.crt

USER 65532:65532

EXPOSE 8080 50051

ENTRYPOINT ["/usr/local/bin/server"]
